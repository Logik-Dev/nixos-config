    {
      "parameters": {
        "jsCode": "const ALLOWED_MIME = new Set([\n  'application/pdf',\n  'application/vnd.openxmlformats-officedocument.wordprocessingml.document', // docx\n  'application/vnd.oasis.opendocument.text',                                 // odt\n  'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',       // xlsx\n]);\nconst ALLOWED_EXT = new Set(['pdf', 'docx', 'odt', 'xlsx']);\n\nconst out = [];\nfor (const item of items) {\n  const bins = item.binary ?? {};\n  for (const key of Object.keys(bins)) {\n    const b = bins[key];\n    const name = b.fileName || 'document';\n    const ext = name.includes('.') ? name.split('.').pop().toLowerCase() : '';\n\n    // on accepte si le mimeType OU l'extension est dans la liste\n    if (!ALLOWED_MIME.has(b.mimeType) && !ALLOWED_EXT.has(ext)) continue;\n\n    out.push({\n      json: {\n        messageId: item.json.id,\n        subject: item.json.subject ?? '',\n        from: item.json.from?.value?.[0]?.address ?? item.json.from ?? '',\n        fileName: name.replace(/[\\/\\\\:*?\"<>|]/g, '_'),\n        mimeType: b.mimeType,\n      },\n      binary: { data: b },\n    });\n  }\n}\nreturn out;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -304,
        -16
      ],
      "id": "1af91e6d-4345-4358-8b90-15096b8c33a2",
      "name": "Split Binaries"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Tu classifies des emails avec pièce jointe pour un archivage documentaire, et tu proposes un titre de document propre.\n\nExpéditeur : {{ $json.from }}\nSujet : {{ $json.subject }}\nNom du fichier : {{ $json.fileName }}\n\n1. important : true si c'est un document à archiver (facture, contrat, attestation, relevé bancaire, document fiscal / administratif / médical / assurance, bulletin de salaire, garantie). false pour newsletter, publicité, catalogue, confirmation marketing.\n2. title : titre court et lisible, sans extension (ex: \"Facture EDF novembre 2025\"). Propose un titre même si important est false.\n\nRéponds uniquement en JSON, sans texte autour : {\"important\": true, \"title\": \"...\"}",
        "hasOutputParser": true,
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        -128,
        -16
      ],
      "id": "61c05cc0-c8f6-4f83-9f26-0bc4ebb4a574",
      "name": "Décision de conservation"
    },
    {
      "parameters": {
        "jsCode": "// Mode : \"Run Once for All Items\"\nconst src = $('Split Binaries').all();\nconst out = [];\n\nfor (const llm of $input.all()) {\n  const p = llm.json.pairedItem;\n  const srcIndex = Array.isArray(p) ? p[0].item : (p?.item ?? 0);\n  const s = src[srcIndex];\n\n  out.push({\n    json: {\n      ...s.json,                 // messageId, fileName, subject, from, mimeType\n      output: llm.json.output,   // { important, title }\n    },\n    binary: s.binary,            // { data: <PDF> } recollé\n  });\n}\nreturn out;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
